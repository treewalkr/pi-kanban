{
  "name": "pi-kanban",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "bin": {
    "kanban": "./src/cli.ts"
  },
  "scripts": {
    "dev:api": "KANBAN_DEV=1 bun run --watch src/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -n api,web -c blue,green 'bun run dev:api' 'bun run dev:web'",
    "build": "vite build",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "check": "svelte-check --workspace web && tsc --noEmit -p tsconfig.src.json"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@lucide/svelte": "^1.64.0",
    "dompurify": "^3.4.17",
    "elysia": "^1.4.30",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.3",
    "@types/jsdom": "^30.0.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}
